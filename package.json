{
  "name": "courseplex",
  "version": "0.1.4",
  "description": "Personal Netflix & Plex for local video courses",
  "author": "Dudeque",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently -k \"next dev\" \"electron .\"",
    "build": "next build",
    "build:electron": "next build && node scripts/prepare-standalone.js && node scripts/patch-balanced-match.js",
    "dist:win": "pnpm build:electron && electron-builder --win",
    "postinstall": "node scripts/patch-balanced-match.js",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "packageManager": "pnpm@9.15.9"
}
